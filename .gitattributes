# Les scripts shell doivent rester en LF (CRLF casse bash)
*.sh text eol=lf

# Le script PixInsight aussi : l'asset brut des releases et la copie
# embarquée dans le zip de distribution doivent être identiques
*.js text eol=lf

# L'icône embarquée dans le zip de distribution est normalisée en LF au
# staging : autant que le fichier versionné soit déjà identique
*.svg text eol=lf

# Documentation: PIDoc sources and the pages compiled from them ship in
# the update package; keep them byte-identical across platforms
*.pidoc text eol=lf
*.html text eol=lf
